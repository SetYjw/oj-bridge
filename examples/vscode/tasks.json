{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OJ Bridge: prepare exe folder",
      "type": "process",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": ["-NoProfile", "-NonInteractive", "-Command", "[System.IO.Directory]::CreateDirectory($env:OJ_BRIDGE_OUTPUT) | Out-Null"],
      "options": { "env": { "OJ_BRIDGE_OUTPUT": "${workspaceFolder}\\exe" } },
      "problemMatcher": [],
      "hide": true
    },
    {
      "label": "OJ Bridge: build active C++ file",
      "type": "process",
      "command": "g++",
      "args": ["-g", "-std=c++20", "${file}", "-o", "${workspaceFolder}\\exe\\${fileBasenameNoExtension}.exe"],
      "options": { "cwd": "${fileDirname}" },
      "dependsOn": "OJ Bridge: prepare exe folder",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
